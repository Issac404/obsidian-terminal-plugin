{
  "name": "obsidian-terminal-commands",
  "version": "0.2.1",
  "description": "Open an Obsidian vault in a terminal and launch configurable shell commands.",
  "author": "Issac404",
  "scripts": {
    "dev": "rollup --config rollup.config.mjs --watch",
    "build": "rollup --config rollup.config.mjs",
    "lint": "eslint . && stylelint styles.css",
    "test": "vitest run",
    "check": "npm run lint && tsc --noEmit && npm test && npm run build"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "terminal"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.1",
    "rollup": "^4.62.5",
    "stylelint": "^16.26.1",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
